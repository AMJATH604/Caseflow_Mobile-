# ═══════════════════════════════════════════════════════════
# CaseFlow Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env files to git!
# ═══════════════════════════════════════════════════════════

# ─── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Gemini AI (server-side only, set in Supabase secrets) ─
GEMINI_API_KEY=your-gemini-api-key

# ─── Firebase (for push notifications) ───────────────────
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ─── Dashboard (Vite env vars prefixed with VITE_) ───────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Bar Association Elections ───────────────────────────
# Set in Supabase: ALTER DATABASE postgres SET app.settings.election_salt = 'your-random-salt';
# ELECTION_SALT=generate-a-random-string-here

# ─── Optional: iLovePDF (for PDF tools edge function) ────
# ILOVEPDF_PUBLIC_KEY=your-ilovepdf-public-key
# ILOVEPDF_SECRET_KEY=your-ilovepdf-secret-key

# ─── Optional: GitHub Actions Secrets ────────────────────
# GOOGLE_SERVICES_JSON=base64-encoded-google-services-json
# FIREBASE_APP_ID=your-firebase-app-id
# FIREBASE_CREDENTIALS=firebase-service-account-json
