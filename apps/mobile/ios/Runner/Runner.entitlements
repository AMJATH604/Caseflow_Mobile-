<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. Without it iOS gives the app no push
	     token, so Firebase has nowhere to deliver hearing reminders or chat
	     messages. "development" is for builds run from Xcode; archiving for
	     TestFlight / the App Store signs it as production automatically. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
